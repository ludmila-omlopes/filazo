{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:sync-monitor && npm run build",
  "crons": [
    { "path": "/api/internal/steam-sync-worker", "schedule": "0 3,9,15,21 * * *" },
    { "path": "/api/internal/playstation-sync-worker", "schedule": "0 3,9,15,21 * * *" },
    { "path": "/api/internal/game-metadata-worker", "schedule": "0 3,9,15,21 * * *" },
    { "path": "/api/internal/platform-sync", "schedule": "0 3,9,15,21 * * *" },
    { "path": "/api/internal/sync-monitor", "schedule": "1 3,9,15,21 * * *" },
    { "path": "/api/internal/game-discovery-worker", "schedule": "1 3,9,15,21 * * *" },
    { "path": "/api/internal/abuse-cleanup", "schedule": "2 3,9,15,21 * * *" },
    { "path": "/api/internal/calendar-refresh", "schedule": "2 3,9,15,21 * * *" },
    { "path": "/api/internal/calendar-releases", "schedule": "2 3 * * *" }
  ]
}

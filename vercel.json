{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:sync-monitor && npm run build",
  "crons": [
    {
      "path": "/api/internal/abuse-cleanup",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/sync-monitor",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/steam-sync-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/game-metadata-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/platform-sync",
      "schedule": "0 * * * *"
    }
  ]
}

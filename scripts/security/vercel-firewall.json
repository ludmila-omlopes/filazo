{
  "firewallEnabled": true,
  "managedRules": {
    "bot_protection": {
      "active": true,
      "action": "challenge"
    }
  },
  "rules": [
    {
      "name": "Filazo - signed internal workers",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "path",
              "op": "inc",
              "value": [
                "/api/internal/platform-sync",
                "/api/internal/steam-sync-worker",
                "/api/internal/game-metadata-worker",
                "/api/internal/sync-monitor",
                "/api/internal/abuse-cleanup"
              ]
            },
            {
              "type": "method",
              "op": "eq",
              "value": "GET"
            },
            {
              "type": "header",
              "op": "ex",
              "key": "authorization"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "bypass",
          "bypassSystem": false
        }
      }
    },
    {
      "name": "Filazo - signed Stripe notifications",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "path",
              "op": "eq",
              "value": "/api/billing/webhook"
            },
            {
              "type": "method",
              "op": "eq",
              "value": "POST"
            },
            {
              "type": "header",
              "op": "ex",
              "key": "stripe-signature"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "bypass",
          "bypassSystem": false
        }
      }
    },
    {
      "name": "Filazo - login and support POST",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "path",
              "op": "inc",
              "value": [
                "/login",
                "/feedback"
              ]
            },
            {
              "type": "method",
              "op": "eq",
              "value": "POST"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "algo": "fixed_window",
            "window": 60,
            "limit": 30,
            "keys": [
              "ip"
            ],
            "action": "rate_limit"
          }
        }
      }
    },
    {
      "name": "Filazo - server action bursts",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "method",
              "op": "eq",
              "value": "POST"
            },
            {
              "type": "header",
              "op": "ex",
              "key": "next-action"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "algo": "fixed_window",
            "window": 60,
            "limit": 120,
            "keys": [
              "ip"
            ],
            "action": "rate_limit"
          }
        }
      }
    },
    {
      "name": "Filazo - search assistant upload bursts",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "path",
              "op": "inc",
              "value": [
                "/api/profile/game-search",
                "/api/journal/upload",
                "/api/assistant/chat",
                "/api/assistant/marketplaces",
                "/api/assistant/buy-decision"
              ]
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "algo": "fixed_window",
            "window": 60,
            "limit": 120,
            "keys": [
              "ip"
            ],
            "action": "rate_limit"
          }
        }
      }
    }
  ],
  "ips": []
}
